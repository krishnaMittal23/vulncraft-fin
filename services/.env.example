# Django scanning service — copy to services/.env and fill in real values.
# docker-compose reads these via ${VAR} interpolation. NEVER commit real values.

# GitHub integration (rotate any previously committed values!)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: WPScan API token (enriches WordPress vuln results)
WPSCAN_API_TOKEN=
